<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/fpv_bg_dark"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="SYSTEM CONFIGURATION"
                android:textColor="@color/fpv_cyan"
                android:textSize="17sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset_defaults"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RESET"
                    android:textColor="@color/fpv_text_secondary"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/btn_close_settings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_control_button"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_fullscreen_exit"
                    app:tint="@color/fpv_text_primary" />
            </LinearLayout>
        </RelativeLayout>

        <!-- ==================== SECTION 1: BLUETOOTH & TELEMETRY ==================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:text="TELEMETRY &amp; DATA LINK"
            android:textColor="@color/fpv_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/fpv_control_bg"
            app:cardCornerRadius="10dp"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Bluetooth Status & Connect Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_bt_status_badge"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Status: Disconnected"
                        android:textColor="@color/fpv_text_secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_bt_connect_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:backgroundTint="@color/fpv_button_normal"
                        android:text="Connect"
                        android:textColor="@color/fpv_cyan"
                        android:textSize="12sp"
                        app:cornerRadius="6dp"
                        app:strokeColor="@color/fpv_cyan"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <!-- Paired Device Selection -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Select Paired Bluetooth Device (Skydroid T12 / Radio):"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_bt_devices"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_osd_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <!-- Telemetry Source -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Primary Telemetry Source:"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_telemetry_source"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_osd_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <!-- Telemetry Baud Rate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="MAVLink Baud Rate:"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_telemetry_baud"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_osd_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <!-- Forward to UDP -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_forward_udp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Forward MAVLink to UDP 127.0.0.1:14550\n(Allows QGroundControl/Mission Planner running simultaneously)"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp"
                    app:useMaterialThemeColors="true" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== SECTION 2: VIDEO & RECEIVER ==================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="VIDEO RECEIVER &amp; HARDWARE"
            android:textColor="@color/fpv_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/fpv_control_bg"
            app:cardCornerRadius="10dp"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Receiver Type -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Receiver Hardware Type:"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_receiver_type"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_osd_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <!-- USB UART Baud Rate -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="USB UART Bridge Baud Rate:"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_usb_baud"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_osd_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <!-- Latency Profile -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Latency Buffer Profile:"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_latency_profile"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_osd_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== SECTION 3: MAP & NAVIGATION ==================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="MAP &amp; SPATIAL NAVIGATION"
            android:textColor="@color/fpv_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/fpv_control_bg"
            app:cardCornerRadius="10dp"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Default Map Layer:"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinner_map_layer"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_osd_badge"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_map_auto_follow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Auto-Follow Drone on Map"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_map_trail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Show Live Flight Path Breadcrumbs"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_map_home_bearing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Show Home Point &amp; Return Bearing Line"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ==================== SECTION 4: DVR & AUDIO ==================== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="DIGITAL VIDEO RECORDER (DVR)"
            android:textColor="@color/fpv_cyan"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/fpv_control_bg"
            app:cardCornerRadius="10dp"
            app:strokeColor="#22FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_dvr_audio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Record Cockpit Audio (Microphone) with Flight Video"
                    android:textColor="@color/fpv_text_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
